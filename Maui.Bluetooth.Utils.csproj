<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net10.0-android;net10.0-ios</TargetFrameworks>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    
    <!-- iOS Build Settings -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    
    <!-- NuGet Package Information -->
    <PackageId>Ble.Print.Utils</PackageId>
    <Title>MAUI Bluetooth Printer Utils</Title>
    <Description>Cross-platform Bluetooth printer library for .NET MAUI supporting ESC/POS and Zebra printers</Description>
    <Authors>Bestekarx</Authors>
    <PackageTags>maui,bluetooth,printer,esc-pos,zebra,android,ios</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bestekarx/Maui.Bluetooth.Utils</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bestekarx/Maui.Bluetooth.Utils</RepositoryUrl>
    <Version>1.0.3</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>



  <!-- Package references -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" Condition="'$(TargetFramework)' == 'net9.0-android' OR '$(TargetFramework)' == 'net9.0-ios'" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0-android' OR '$(TargetFramework)' == 'net10.0-ios'" />

    <PackageReference Include="Microsoft.Maui.Essentials" Version="9.0.0" Condition="'$(TargetFramework)' == 'net9.0-android' OR '$(TargetFramework)' == 'net9.0-ios'" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0-android' OR '$(TargetFramework)' == 'net10.0-ios'" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" Condition="'$(TargetFramework)' == 'net9.0-android' OR '$(TargetFramework)' == 'net9.0-ios'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0-android' OR '$(TargetFramework)' == 'net10.0-ios'" />


    <PackageReference Include="Zebra.Printer.SDK" Version="3.0.3337" />
  </ItemGroup>

  <!-- Shared files for all platforms -->
  <ItemGroup>
    <Compile Include="Shared\**\*.cs" />
  </ItemGroup>

  <!-- Android-specific files for .NET 9 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
    <Compile Include="Platforms\Android\**\*.cs" />
  </ItemGroup>

  <!-- iOS-specific files for .NET 9 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-ios'">
    <Compile Include="Platforms\iOS\**\*.cs" />
  </ItemGroup>

  <!-- Android-specific files for .NET 10 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <Compile Include="Platforms\Android\**\*.cs" />
  </ItemGroup>

  <!-- iOS-specific files for .NET 10 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <Compile Include="Platforms\iOS\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="logo.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Exclude AAR files from package - not needed for .NET MAUI libraries -->
  <!-- AAR files are only for Java/Kotlin libraries, not .NET MAUI -->
  <Target Name="ExcludeAarFromPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_PackageFilesToExclude Include="@(_PackageFiles)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('.aar'))" />
      <_PackageFiles Remove="@(_PackageFilesToExclude)" />
    </ItemGroup>
  </Target>

</Project> 